include(FetchContent)
FetchContent_Declare(freeimage_source
 URL https://downloads.sourceforge.net/freeimage/FreeImage3180.zip
 URL_HASH SHA256=f41379682f9ada94ea7b34fe86bf9ee00935a3147be41b6569c9605a53e438fd)
FetchContent_GetProperties(freeimage_source)
if(NOT freeimage_source_POPULATED)
 FetchContent_Populate(freeimage_source)
endif()
set(FI "${freeimage_source_SOURCE_DIR}")
file(READ "${FI}/Makefile.srcs" FI_MAKE)
string(REGEX MATCH "SRCS = ([^\n]+)" FI_MATCH "${FI_MAKE}")
separate_arguments(FI_SOURCES UNIX_COMMAND "${CMAKE_MATCH_1}")
list(TRANSFORM FI_SOURCES PREPEND "${FI}/")
# Table generators are build tools, not library objects: each defines main.
list(FILTER FI_SOURCES EXCLUDE REGEX "/(b44ExpLogTable|dwaLookups|eLut|toFloat)\\.cpp$")
add_library(FreeImage STATIC ${FI_SOURCES})
string(REGEX MATCH "INCLUDE = ([^\n]+)" FI_MATCH "${FI_MAKE}")
string(REPLACE "-I" "${FI}/" FI_INCLUDES "${CMAKE_MATCH_1}")
separate_arguments(FI_INCLUDES UNIX_COMMAND "${FI_INCLUDES}")
target_include_directories(FreeImage PRIVATE ${FI_INCLUDES})
target_compile_definitions(FreeImage PRIVATE FREEIMAGE_LIB OPJ_STATIC LIBRAW_NODLL DISABLE_PERF_MEASUREMENT)
if(MINGW)
 target_compile_options(FreeImage PRIVATE $<$<COMPILE_LANGUAGE:CXX>:-include;stdexcept;-Wno-narrowing>)
endif()
# The old JPEG-XR SDK guiddef.h shadows the compiler SDK on MinGW.
list(REMOVE_ITEM FI_INCLUDES "${FI}/Source/LibJXR/common/include")
file(COPY "${FI}/Source/LibJXR/common/include/" DESTINATION "${CMAKE_CURRENT_BINARY_DIR}/jxr-headers" PATTERN "guiddef.h" EXCLUDE)
set_property(TARGET FreeImage PROPERTY INCLUDE_DIRECTORIES "${FI_INCLUDES};${CMAKE_CURRENT_BINARY_DIR}/jxr-headers")
set_property(TARGET FreeImage PROPERTY CXX_STANDARD 14)
file(READ "${FI}/Source/OpenEXR/IlmImf/ImfSystemSpecific.h" EXR_SYSTEM)
set(EXR_SYSTEM_OLD "${EXR_SYSTEM}")
string(REPLACE "posix_memalign(&ptr, alignment, size);" "ptr = _aligned_malloc(size, alignment);" EXR_SYSTEM "${EXR_SYSTEM}")
string(REPLACE "    free(ptr);" "    _aligned_free(ptr);" EXR_SYSTEM "${EXR_SYSTEM}")
if(NOT EXR_SYSTEM STREQUAL EXR_SYSTEM_OLD)
 file(WRITE "${FI}/Source/OpenEXR/IlmImf/ImfSystemSpecific.h" "${EXR_SYSTEM}")
endif()
file(READ "${FI}/Source/OpenEXR/IlmImf/ImfOptimizedPixelReading.h" EXR_READING)
set(EXR_READING_OLD "${EXR_READING}")
string(REPLACE "(unsigned long)" "(size_t)" EXR_READING "${EXR_READING}")
if(NOT EXR_READING STREQUAL EXR_READING_OLD)
 file(WRITE "${FI}/Source/OpenEXR/IlmImf/ImfOptimizedPixelReading.h" "${EXR_READING}")
endif()
# ImfAttribute.cpp uses std::binary_function but includes only <map>; current MSVC
# standard libraries declare it in <functional> alone.
file(READ "${FI}/Source/OpenEXR/IlmImf/ImfAttribute.cpp" EXR_ATTRIBUTE)
set(EXR_ATTRIBUTE_OLD "${EXR_ATTRIBUTE}")
string(REPLACE "#include <map>\n" "#include <map>\n#include <functional>\n" EXR_ATTRIBUTE "${EXR_ATTRIBUTE}")
if(NOT EXR_ATTRIBUTE MATCHES "#include <functional>")
 message(FATAL_ERROR "FreeImage: ImfAttribute.cpp no longer has the include this build patches")
endif()
if(NOT EXR_ATTRIBUTE STREQUAL EXR_ATTRIBUTE_OLD)
 file(WRITE "${FI}/Source/OpenEXR/IlmImf/ImfAttribute.cpp" "${EXR_ATTRIBUTE}")
endif()
# Current MinGW provides the same byte-swap routine as the Windows CRT.
file(READ "${FI}/Source/LibJXR/image/sys/strcodec.c" JXR_CODEC)
set(JXR_CODEC_OLD "${JXR_CODEC}")
string(REPLACE "(!defined(__MINGW32__) || defined(__MINGW64_TOOLCHAIN__))" "1" JXR_CODEC "${JXR_CODEC}")
if(NOT JXR_CODEC STREQUAL JXR_CODEC_OLD)
 file(WRITE "${FI}/Source/LibJXR/image/sys/strcodec.c" "${JXR_CODEC}")
endif()
